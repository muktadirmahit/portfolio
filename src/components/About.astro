---
import SectionHead from './SectionHead.astro';
import { timeline } from '../data/about';
import { getCodeforces } from '../data/codeforces';

const cf = await getCodeforces();
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container grid">
    <div class="story">
      <SectionHead label="About" title="How I got here" id="about-title" />
      <div class="prose" data-reveal>
        <p>
          I grew up in Dhaka. Before university I was already building things: in 2022 a teammate and I built a
          remote-controlled security robot and took it to the National Science &amp; Technology Fair.
        </p>
        <p>
          At United International University I found competitive programming and stayed with it: {cf.contests} rated
          contests, two ICPC regionals, and now writing problems and teaching juniors myself.
        </p>
        <p>
          Next, I want to put that problem-solving into software people use every day, on a team of engineers I can learn
          from, and to continue with graduate study abroad.
        </p>
      </div>
    </div>

    <ol class="timeline" aria-label="Timeline">
      {
        timeline.map((t, i) => (
          <li class:list={{ future: t.future }} data-reveal style={`--reveal-delay:${i % 3}`}>
            <p class="timeline__year mono">{t.year}</p>
            <ul>
              {t.items.map((item) => (
                <li>{item.replace("{cfContests}", String(cf.contests))}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .story {
    position: sticky;
    top: 6rem;
  }

  .prose {
    font-size: var(--step-1);
    color: var(--ink-2);
    line-height: 1.6;
  }

  .timeline {
    position: relative;
    display: grid;
    padding: 0;
    list-style: none;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.3rem;
    top: 0.6rem;
    bottom: 0.6rem;
    border-left: 1px solid var(--line-strong);
  }

  .timeline > li {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0 0 2rem 2rem;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--ink);
  }

  .timeline > li.future::before {
    border-style: dashed;
    border-color: var(--accent);
  }

  .timeline__year {
    font-weight: 500;
  }

  .future .timeline__year {
    color: var(--accent);
  }

  .timeline ul {
    display: grid;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .story {
      position: static;
    }
  }

  @media (max-width: 480px) {
    .timeline > li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
      padding-left: 1.75rem;
    }
  }
</style>
