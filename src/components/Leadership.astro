---
import SectionHead from './SectionHead.astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { beatcode, roles, venture } from '../data/about';
---

<section class="section" id="leadership" aria-labelledby="leadership-title">
  <div class="container">
    <SectionHead label="Leadership & community" title="Running things for other people" id="leadership-title">
      Much of what I know about planning, budgets and working with people I learned by organizing contests and teaching
      juniors.
    </SectionHead>

    <div class="grid">
      <article class="beatcode" data-reveal aria-labelledby="beatcode-title">
        <p class="eyebrow">{beatcode.role}</p>
        <h3 id="beatcode-title" class="display">{beatcode.name}</h3>
        <p class="beatcode__context">{beatcode.context}</p>
        <p class="beatcode__figure">
          <span class="mono">{beatcode.figure.value}</span>
          <span>{beatcode.figure.label}</span>
        </p>
        <p class="beatcode__summary">{beatcode.summary}</p>
        <ul class="chips" aria-label="Responsibilities">
          <li class="chip">Sponsorship</li>
          <li class="chip">Budget</li>
          <li class="chip">Session planning</li>
          <li class="chip">Contest rules</li>
          <li class="chip">Public speaking</li>
        </ul>
      </article>

      <ol class="roles">
        {
          roles.map((r, i) => (
            <li data-reveal style={`--reveal-delay:${i}`}>
              {r.logo ? (
                <Image class="logo" src={r.logo} alt={`${r.org} logo`} width={96} height={96} />
              ) : (
                <span class="logo logo--icon" aria-hidden="true">
                  <Icon name="cap" size={24} />
                </span>
              )}
              <div class="roles__text">
                <div class="roles__head">
                  <h3>{r.org}</h3>
                  {r.period && <p class="mono muted">{r.period}</p>}
                </div>
                <p class="roles__role">{r.role}</p>
                <p class="roles__body">{r.body}</p>
              </div>
            </li>
          ))
        }
        <li class="venture" data-reveal style="--reveal-delay:3">
          <Image class="logo logo--light" src={venture.logo} alt={`${venture.name} logo`} width={96} height={96} />
          <div class="roles__text">
            <div class="roles__head">
              <h3>{venture.name}</h3>
              <p class="mono muted">{venture.period}</p>
            </div>
            <p class="roles__role">{venture.role}</p>
            <p class="roles__body">{venture.body}</p>
            <p class="venture__links">
              {
                venture.links.map((l) => (
                  <a class="link-arrow" href={l.href} target="_blank" rel="noopener">
                    {l.label} <Icon name="arrow-up-right" />
                  </a>
                ))
              }
            </p>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .beatcode {
    display: grid;
    gap: 1rem;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--bg);
    position: sticky;
    top: 5.5rem;
  }

  .beatcode .eyebrow {
    color: color-mix(in oklab, var(--bg) 65%, var(--ink));
  }

  h3.display {
    font-size: var(--step-3);
  }

  .beatcode__context {
    color: color-mix(in oklab, var(--bg) 78%, var(--ink));
  }

  .beatcode__figure {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 1rem;
    border-block: 1px solid color-mix(in oklab, var(--bg) 20%, var(--ink));
  }

  .beatcode__figure .mono {
    font-size: clamp(2.6rem, 2rem + 2.4vw, 3.8rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--accent);
  }

  .beatcode__figure span:last-child {
    color: color-mix(in oklab, var(--bg) 78%, var(--ink));
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .beatcode .chip {
    background: transparent;
    border-color: color-mix(in oklab, var(--bg) 25%, var(--ink));
    color: color-mix(in oklab, var(--bg) 85%, var(--ink));
  }

  .roles {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .roles li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: start;
    column-gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .roles li:first-child {
    border-top: 0;
    padding-top: 0.25rem;
  }

  .logo {
    width: 3rem;
    height: 3rem;
    border-radius: 10px;
    object-fit: cover;
    margin-top: 0.15rem;
  }

  .logo--light {
    border: 1px solid var(--line);
  }

  .logo--icon {
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .roles__text {
    display: grid;
    gap: 0.35rem;
  }

  .roles__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .roles__head h3 {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .roles__head p {
    font-size: 0.82rem;
  }

  .roles__role {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .roles__body {
    color: var(--ink-2);
  }

  .venture__links {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.35rem;
    font-size: 0.92rem;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .beatcode {
      position: static;
    }
  }
</style>
