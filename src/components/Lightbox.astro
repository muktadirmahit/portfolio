---
import Icon from './Icon.astro';
---

<dialog id="lightbox" class="lightbox" aria-label="Photo viewer">
  <figure class="lightbox__figure">
    <div class="lightbox__stage">
      <img class="lightbox__img" alt="" decoding="async" />
      <p class="lightbox__loading mono" aria-hidden="true">Loading…</p>
    </div>
    <figcaption class="lightbox__caption">
      <span class="lightbox__text"></span>
      <span class="lightbox__count mono" aria-live="polite"></span>
    </figcaption>
  </figure>
  <button class="lightbox__btn lightbox__close" type="button" data-close aria-label="Close">
    <Icon name="close" size={22} />
  </button>
  <button class="lightbox__btn lightbox__prev" type="button" data-step="-1" aria-label="Previous photo">
    <Icon name="chevron-left" size={24} />
  </button>
  <button class="lightbox__btn lightbox__next" type="button" data-step="1" aria-label="Next photo">
    <Icon name="chevron-right" size={24} />
  </button>
</dialog>

<script>
  // Any element with [data-lightbox] opens here. Items sharing a group name can be stepped through.
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;

  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const text = dialog.querySelector<HTMLElement>('.lightbox__text')!;
    const count = dialog.querySelector<HTMLElement>('.lightbox__count')!;
    const stepBtns = dialog.querySelectorAll<HTMLButtonElement>('[data-step]');
    let items: HTMLElement[] = [];
    let index = 0;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const el = items[index];
      dialog.classList.add('is-loading');
      dialog.classList.remove('is-error');
      img.alt = el.dataset.alt ?? '';
      img.src = el.dataset.full ?? '';
      text.textContent = el.dataset.caption ?? el.dataset.alt ?? '';
      count.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : '';
      stepBtns.forEach((b) => (b.hidden = items.length < 2));
    };

    img.addEventListener('load', () => dialog.classList.remove('is-loading'));
    img.addEventListener('error', () => {
      dialog.classList.remove('is-loading');
      dialog.classList.add('is-error');
      text.textContent = 'This photo could not be loaded.';
    });

    document.addEventListener('click', (e) => {
      const trigger = (e.target as Element).closest<HTMLElement>('[data-lightbox]');
      if (!trigger) return;
      e.preventDefault();
      const group = trigger.dataset.lightbox;
      items = group ? [...document.querySelectorAll<HTMLElement>(`[data-lightbox="${group}"]`)] : [trigger];
      show(items.indexOf(trigger));
      dialog.showModal();
    });

    dialog.addEventListener('click', (e) => {
      const t = e.target as Element;
      const step = t.closest<HTMLElement>('[data-step]');
      if (step) return show(index + Number(step.dataset.step));
      // Clicking the backdrop (the dialog itself, outside the figure) or the close button closes it.
      if (t === dialog || t.closest('[data-close]')) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (items.length < 2) return;
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });

    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
    });
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: clamp(1rem, 4vw, 3rem) clamp(0.5rem, 6vw, 5rem);
    border: 0;
    background: transparent;
    color: #f2efe8;
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgb(10 11 11 / 0.92);
    backdrop-filter: blur(6px);
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox__figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .lightbox__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
    border-radius: 6px;
    pointer-events: auto;
    transition: opacity 0.25s ease;
  }

  .lightbox__loading {
    position: absolute;
    font-size: 0.85rem;
    opacity: 0;
    transition: opacity 0.2s ease 0.2s;
  }

  .is-loading .lightbox__img {
    opacity: 0.25;
  }

  .is-loading .lightbox__loading {
    opacity: 0.7;
  }

  .is-error .lightbox__img {
    opacity: 0;
  }

  .lightbox__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 60rem;
    width: 100%;
    margin-inline: auto;
    font-size: 0.95rem;
    color: #d8d4ca;
    pointer-events: auto;
  }

  .lightbox__count {
    flex: none;
    color: #9d9a92;
    font-size: 0.85rem;
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(20 22 21 / 0.6);
    color: #f2efe8;
    transition: background-color 0.2s ease;
  }

  .lightbox__btn:hover {
    background: rgb(60 62 61 / 0.8);
  }

  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__prev {
    left: 0.75rem;
  }

  .lightbox__next {
    right: 0.75rem;
  }

  @media (max-width: 640px) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
    .lightbox {
      padding-bottom: 4.5rem;
    }
  }
</style>
