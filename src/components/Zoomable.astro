---
// A photo that opens in the shared lightbox. Renders a responsive thumbnail and
// pre-computes one larger optimized version for the viewer.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  group?: string;
  widths?: number[];
  sizes: string;
  class?: string;
  position?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, caption, group, widths = [400, 700, 1000], sizes, class: className, position, loading = 'lazy' } = Astro.props;
const full = await getImage({ src, width: Math.min(src.width, 1800), format: 'webp', quality: 82 });
---

<button
  type="button"
  class:list={['zoomable', className]}
  data-lightbox={group ?? ''}
  data-full={full.src}
  data-alt={alt}
  data-caption={caption}
  aria-label={`View larger: ${caption ?? alt}`}
>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} style={position ? `object-position:${position}` : undefined} />
  <span class="zoomable__hint" aria-hidden="true"><Icon name="expand" size={14} /></span>
</button>

<style>
  .zoomable {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--surface);
    border-radius: inherit;
    overflow: hidden;
    cursor: zoom-in;
  }

  .zoomable :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .zoomable:hover :global(img) {
    transform: scale(1.025);
  }

  .zoomable__hint {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgb(15 17 16 / 0.6);
    color: #fff;
    opacity: 0;
    transition: opacity 0.2s var(--ease);
  }

  .zoomable:hover .zoomable__hint,
  .zoomable:focus-visible .zoomable__hint {
    opacity: 1;
  }

  @media (hover: none) {
    .zoomable__hint {
      opacity: 0.85;
    }
  }
</style>
