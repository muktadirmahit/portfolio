---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import Lightbox from '../components/Lightbox.astro';
import portrait from '../assets/me/al-muktadir-islam-mahit.jpg';
import { profile, seo } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = seo.title, description = seo.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL('/', Astro.site).toString();
const ogImage = new URL('/og.jpg', Astro.site);
const photo = await getImage({ src: portrait, width: 800, format: 'jpg' });
const photoUrl = new URL(photo.src, Astro.site).toString();

// Structured data: tells search engines this page is the profile of one specific person, and that
// the LinkedIn / GitHub / Codeforces profiles (sameAs) are the same person. This is what lets Google
// treat the site as the canonical source for name searches.
const personId = `${home}#person`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${home}#profile`,
      url: home,
      name: title,
      description,
      inLanguage: 'en',
      dateModified: new Date().toISOString().slice(0, 10),
      mainEntity: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: profile.name,
      givenName: profile.givenName,
      familyName: profile.familyName,
      alternateName: profile.alternateNames,
      url: home,
      image: photoUrl,
      email: `mailto:${profile.email}`,
      description:
        'Final-year Computer Science & Engineering student at United International University, competitive programmer and problem setter from Dhaka, Bangladesh.',
      jobTitle: 'Computer Science & Engineering student',
      nationality: { '@type': 'Country', name: 'Bangladesh' },
      address: { '@type': 'PostalAddress', addressLocality: 'Dhaka', addressCountry: 'BD' },
      affiliation: { '@type': 'CollegeOrUniversity', name: profile.university, url: profile.universityUrl },
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: profile.university, url: profile.universityUrl },
        { '@type': 'EducationalOrganization', name: 'Birshreshtha Noor Mohammad Public College' },
        { '@type': 'EducationalOrganization', name: 'Mohammadpur Preparatory School & College' },
      ],
      knowsAbout: ['Competitive programming', 'Algorithms', 'Data structures', 'Software development', 'Java', 'C++', 'Embedded systems', 'ICPC'],
      knowsLanguage: ['bn', 'en'],
      sameAs: Object.values(profile.links),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={profile.name} />
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
    {seo.googleSiteVerification && <meta name="google-site-verification" content={seo.googleSiteVerification} />}
    {Object.values(profile.links).map((href) => <link rel="me" href={href} />)}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, portfolio`} />
    <meta property="profile:first_name" content="Al-Muktadir Islam" />
    <meta property="profile:last_name" content="Mahit" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <!-- Light by default; apply a saved choice (from the theme button) before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <Lightbox />

    <script>
      // Reveal-on-scroll: one shared observer, unobserves each element after it appears.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
